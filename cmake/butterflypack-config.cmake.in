# - Config file for the ButterflyPACK package
#
# It defines the following variables
#  ButterflyPACK_FOUND        - ButterflyPACK was found or not
#  ButterflyPACK_INCLUDE_DIRS - include directories for ButterflyPACK
#  ButterflyPACK_LIBRARIES    - libraries to link against
#
# And the following imported targets:
#   ButterflyPACK::butterflypack
#
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@enable_h2_gpu@)
  find_dependency(CUDAToolkit)
endif()
if(@enable_parsec@)
  find_dependency(PaRSEC CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/butterflypack-config-version.cmake")
if(NOT TARGET ButterflyPACK::butterflypack)
  include("${CMAKE_CURRENT_LIST_DIR}/butterflypack-targets.cmake")
endif()

set(ButterflyPACK_LIBRARIES ButterflyPACK::butterflypack)
set(ButterflyPACK_INCLUDE_DIRS
  $<TARGET_PROPERTY:ButterflyPACK::butterflypack,INTERFACE_INCLUDE_DIRECTORIES>)
set(ButterflyPACK_USE_GPU @enable_h2_gpu@)
check_required_components(ButterflyPACK)
